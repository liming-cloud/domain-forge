# 复制到仓库外受保护文件（chmod 600）并填写；不要提交实际值。生成方法见 deploy/README.md。

# 依赖凭据
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Nacos 鉴权：AUTH_TOKEN 为 Base64（至少 32 字节）；IDENTITY_KEY／VALUE 为任意随机串。
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
# 管理员 nacos 的初始密码，只在首次启动时生效。
NACOS_ADMIN_PASSWORD=
# 服务注册与发现专用账号。
NACOS_SERVICE_USERNAME=domainforge
NACOS_SERVICE_PASSWORD=

# IAM 敏感输入 HMAC 密钥：Base64，32 字节。
IAM_FINGERPRINT_KEY=
IAM_IMAGE_TAG=local

# 公开入口；生产环境把 NGINX_HTTP_BIND 改为 0.0.0.0 或指定网卡地址。
NGINX_HTTP_BIND=127.0.0.1
NGINX_HTTP_PORT=8080

# 仅 compose.local.yml 使用的回环端口
POSTGRES_PORT=5432
REDIS_PORT=6379
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_CONSOLE_PORT=18080
