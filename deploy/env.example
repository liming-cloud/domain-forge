# 复制到仓库外受保护文件（chmod 600）并填写；不要提交实际值。生成方法见 deploy/README.md。

# 依赖凭据
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Nacos 鉴权：AUTH_TOKEN 为 Base64（至少 32 字节）；IDENTITY_KEY／VALUE 为任意随机串。
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
# 管理员 nacos 的初始密码，只在首次启动时生效。
NACOS_ADMIN_PASSWORD=
# 服务注册与发现专用账号。
NACOS_SERVICE_USERNAME=domainforge
NACOS_SERVICE_PASSWORD=

# 定时任务（PowerJob）：数据库账号密码、控制台管理员 ADMIN 的初始密码（只在首次启动时生效）、各服务登记任务用的应用密码。
POWERJOB_DB_PASSWORD=
POWERJOB_ADMIN_PASSWORD=
POWERJOB_APP_PASSWORD=

# IAM 敏感输入 HMAC 密钥：Base64，32 字节。
IAM_FINGERPRINT_KEY=
IAM_IMAGE_TAG=local

# 公开入口；生产环境把 NGINX_HTTP_BIND 改为 0.0.0.0 或指定网卡地址。
NGINX_HTTP_BIND=127.0.0.1
NGINX_HTTP_PORT=8080

# 仅 compose.https.yml 使用：证书目录（含 fullchain.pem 与 privkey.pem，私钥 chmod 600）、公开 HTTPS 端口与 HSTS。
# 生产一般为 0.0.0.0 与 443；HSTS 默认关闭，确认证书与续期稳定后再设为例如 max-age=31536000。
NGINX_TLS_DIR=
NGINX_HTTPS_BIND=127.0.0.1
NGINX_HTTPS_PORT=8443
NGINX_HSTS=

# 仅 compose.local.yml 使用的回环端口
POSTGRES_PORT=5432
REDIS_PORT=6379
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_CONSOLE_PORT=18080
