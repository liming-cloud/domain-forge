<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.domainforge.iam.infrastructure.persistence.operation.CoordinationMapper">
    <select id="exclusive" resultType="java.lang.String">
        SELECT name FROM iam_coordination WHERE name = #{name} FOR UPDATE
    </select>
    <select id="shared" resultType="java.lang.String">
        SELECT name FROM iam_coordination WHERE name = #{name} FOR SHARE
    </select>
</mapper>
