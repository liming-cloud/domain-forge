      <exclusions><exclusion><groupId>org.redisson</groupId><artifactId>redisson</artifactId></exclusion></exclusions>
    </dependency>
    <!-- 原运行包已有同版 JSON 适配；显式 runtime 声明防止测试直接引用挤掉原传递运行库。 -->
