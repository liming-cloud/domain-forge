    <dependency><groupId>org.redisson</groupId><artifactId>redisson</artifactId><version>${redisson.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.zaxxer</groupId><artifactId>HikariCP</artifactId><scope>runtime</scope></dependency>
