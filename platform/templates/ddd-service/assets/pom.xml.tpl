    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>4.0.8</spring-boot.version>
    <project.build.outputTimestamp>2026-10-16T00:00:00Z</project.build.outputTimestamp>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.domainforge</groupId>
        <artifactId>domain-forge-bom</artifactId>
        <version>0.2.0-2b.1</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.domainforge</groupId>
      <artifactId>domain-forge-web-support</artifactId>
