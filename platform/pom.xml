<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.domainforge</groupId>
    <artifactId>platform</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <!-- 仓库内部 parent 与聚合；外部消费项目无需继承。 -->
    <modules>
        <module>domain-forge-build-rules</module>
        <module>shared</module>
        <module>framework</module>
        <module>domain-forge-bom</module>
        <module>services</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-10-15T00:00:00Z</project.build.outputTimestamp>
        <spring-boot.version>4.1.2</spring-boot.version>
        <redisson.version>4.8.0</redisson.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <!-- 统一质量检查：mvn verify 即完整门禁，规则说明见 docs 中的源码规范。 -->
        <domain-forge-build-rules.version>0.1.0</domain-forge-build-rules.version>
        <rules.dir>${maven.multiModuleProjectDirectory}/domain-forge-build-rules/src/main/resources</rules.dir>
        <spotless.version>3.10.4</spotless.version>
        <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
        <checkstyle.version>14.3.0</checkstyle.version>
        <dependency-plugin.version>3.11.0</dependency-plugin.version>
        <!-- 集成测试：failsafe 运行 *IT，docker-maven-plugin 在 pre-integration-test 启动隔离依赖。 -->
        <failsafe.version>3.6.1</failsafe.version>
        <docker-maven-plugin.version>0.49.0</docker-maven-plugin.version>
        <it.postgres.image>
            postgres:18.4-alpine3.24@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
        </it.postgres.image>
        <it.redis.image>redis:8.8.1-trixie@sha256:c88d347edef6249a6d2293f926f1eeb48bd40c57cbcd02c07f52e7f1fd2cb46b
        </it.redis.image>
        <it.password>domainforge-it-only</it.password>
        <it.redis.container>domain-forge-it-${project.artifactId}-redis</it.redis.container>
        <!-- 与 deploy/compose.yml 相同的 Nacos 镜像；只有声明 nacos 过滤的模块启动它。 -->
        <it.nacos.image>nacos/nacos-server:v3.1.1@sha256:13e74786507abbacebe080fae2fc9c05aa2591eb99c97a0a78ff0e72beb21b13
        </it.nacos.image>
        <it.nacos.container>domain-forge-it-${project.artifactId}-nacos</it.nacos.container>
        <!--
          与 deploy/compose.yml 相同的 RocketMQ 镜像，单容器运行 namesrv＋broker（内置 proxy）。
          proxy 返回的路由地址是 brokerIP1 与它自己的 gRPC 端口，宿主机上的测试要能连上，端口只能做同号固定映射。
        -->
        <it.rocketmq.image>apache/rocketmq:5.5.0@sha256:7e8f6c9dbd9df742ed26ba69c00d4ad69e2f86a56f3ca7782ff8144dd0798132
        </it.rocketmq.image>
        <it.rocketmq.port>18181</it.rocketmq.port>
        <it.rocketmq.container>domain-forge-it-${project.artifactId}-rocketmq</it.rocketmq.container>
        <!--
          与 deploy/compose.yml 相同的 PowerJob 服务端镜像，表建在 PostgreSQL 容器的 public schema。服务端通过同号固定映射的
          通信端口与宿主机上的 worker 互通（对外声明 127.0.0.1），并经 host-gateway 连回 worker（worker 声明 host.docker.internal）。
        -->
        <it.powerjob.image>powerjob/powerjob-server:v5.1.7@sha256:2b1f7e86cc500668c39d870b1bfac40dbd795258736de2e4e7142766bf836d73
        </it.powerjob.image>
        <it.powerjob.transport.port>17710</it.powerjob.transport.port>
        <it.network>domain-forge-it-${project.artifactId}</it.network>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.8.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                    <configuration>
                        <failIfNoTests>true</failIfNoTests>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                    <configuration>
                        <archive>
                            <manifest>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe.version}</version>
                    <configuration>
                        <!-- Boot repackage 后的 JAR 不能直接作类路径，使用编译输出目录。 -->
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        <!-- 固定顺序：默认按文件系统顺序，macOS 与 CI 的 Linux 不同，曾掩盖进程级单例导致的顺序依赖。 -->
                        <runOrder>alphabetical</runOrder>
                        <environmentVariables>
                            <POSTGRES_PORT>${it.postgres.port}</POSTGRES_PORT>
                            <POSTGRES_PASSWORD>${it.password}</POSTGRES_PASSWORD>
                            <REDIS_PORT>${it.redis.port}</REDIS_PORT>
                            <REDIS_PASSWORD>${it.password}</REDIS_PASSWORD>
                            <REDIS_CONTAINER>${it.redis.container}</REDIS_CONTAINER>
                            <NACOS_PORT>${it.nacos.port}</NACOS_PORT>
                            <NACOS_GRPC_PORT>${it.nacos.grpc.port}</NACOS_GRPC_PORT>
                            <NACOS_CONTAINER>${it.nacos.container}</NACOS_CONTAINER>
                            <NACOS_ADMIN_PASSWORD>${it.password}</NACOS_ADMIN_PASSWORD>
                            <ROCKETMQ_ENDPOINTS>127.0.0.1:${it.rocketmq.port}</ROCKETMQ_ENDPOINTS>
                            <ROCKETMQ_CONTAINER>${it.rocketmq.container}</ROCKETMQ_CONTAINER>
                            <POWERJOB_PORT>${it.powerjob.port}</POWERJOB_PORT>
                            <POWERJOB_ADMIN_PASSWORD>${it.password}</POWERJOB_ADMIN_PASSWORD>
                            <IAM_DB_URL>jdbc:postgresql://127.0.0.1:${it.postgres.port}/domainforge</IAM_DB_URL>
                            <IAM_DB_USER>domainforge</IAM_DB_USER>
                            <IAM_DB_PASSWORD>${it.password}</IAM_DB_PASSWORD>
                            <IAM_REDIS_HOST>127.0.0.1</IAM_REDIS_HOST>
                            <IAM_REDIS_PORT>${it.redis.port}</IAM_REDIS_PORT>
                            <IAM_REDIS_PASSWORD>${it.password}</IAM_REDIS_PASSWORD>
                            <IAM_FINGERPRINT_KEY>AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=</IAM_FINGERPRINT_KEY>
                        </environmentVariables>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>io.fabric8</groupId>
                    <artifactId>docker-maven-plugin</artifactId>
                    <version>${docker-maven-plugin.version}</version>
                    <configuration>
                        <!-- 自定义网络按模块隔离，停止容器时一并删除。 -->
                        <autoCreateCustomNetworks>true</autoCreateCustomNetworks>
                        <images>
                            <image>
                                <alias>postgres</alias>
                                <name>${it.postgres.image}</name>
                                <run>
                                    <!-- 自定义网络：PowerJob 服务端容器按别名 postgres 连接（只有声明 powerjob 的模块用到）。 -->
                                    <network>
                                        <mode>custom</mode>
                                        <name>${it.network}</name>
                                        <alias>postgres</alias>
                                    </network>
                                    <containerNamePattern>domain-forge-it-${project.artifactId}-%a
                                    </containerNamePattern>
                                    <env>
                                        <POSTGRES_DB>domainforge</POSTGRES_DB>
                                        <POSTGRES_USER>domainforge</POSTGRES_USER>
                                        <POSTGRES_PASSWORD>${it.password}</POSTGRES_PASSWORD>
                                    </env>
                                    <ports>
                                        <port>127.0.0.1:it.postgres.port:5432</port>
                                    </ports>
                                    <tmpfs>
                                        <mount>/var/lib/postgresql</mount>
                                    </tmpfs>
                                    <wait>
                                        <log>(?s)init process complete.*ready to accept connections</log>
                                        <time>90000</time>
                                    </wait>
                                </run>
                            </image>
                            <image>
                                <alias>redis</alias>
                                <name>${it.redis.image}</name>
                                <run>
                                    <containerNamePattern>domain-forge-it-${project.artifactId}-%a
                                    </containerNamePattern>
                                    <cmd>
                                        <exec>
                                            <arg>redis-server</arg>
                                            <arg>--requirepass</arg>
                                            <arg>${it.password}</arg>
                                            <arg>--notify-keyspace-events</arg>
                                            <arg>E$gx</arg>
                                            <!-- 与 deploy/compose.yml 一致：IAM 登录防护要求有上限的 noeviction 节点。 -->
                                            <arg>--maxmemory</arg>
                                            <arg>256mb</arg>
                                            <arg>--maxmemory-policy</arg>
                                            <arg>noeviction</arg>
                                            <arg>--save</arg>
                                            <arg>""</arg>
                                            <arg>--appendonly</arg>
                                            <arg>no</arg>
                                        </exec>
                                    </cmd>
                                    <ports>
                                        <port>127.0.0.1:it.redis.port:6379</port>
                                    </ports>
                                    <wait>
                                        <log>Ready to accept connections</log>
                                        <time>60000</time>
                                    </wait>
                                </run>
                            </image>
                            <image>
                                <alias>nacos</alias>
                                <name>${it.nacos.image}</name>
                                <run>
                                    <containerNamePattern>domain-forge-it-${project.artifactId}-%a
                                    </containerNamePattern>
                                    <env>
                                        <MODE>standalone</MODE>
                                        <NACOS_AUTH_ENABLE>true</NACOS_AUTH_ENABLE>
                                        <!-- 仅集成测试使用的固定鉴权参数（Base64，至少 32 字节）。 -->
                                        <NACOS_AUTH_TOKEN>ZG9tYWluZm9yZ2UtaXQtb25seS1uYWNvcy10b2tlbi0zMmI=</NACOS_AUTH_TOKEN>
                                        <NACOS_AUTH_IDENTITY_KEY>domainforge-it</NACOS_AUTH_IDENTITY_KEY>
                                        <NACOS_AUTH_IDENTITY_VALUE>domainforge-it</NACOS_AUTH_IDENTITY_VALUE>
                                        <JVM_XMS>256m</JVM_XMS>
                                        <JVM_XMX>256m</JVM_XMX>
                                        <JVM_XMN>128m</JVM_XMN>
                                    </env>
                                    <!-- 客户端按 HTTP 端口加偏移连接 gRPC；随机端口下由测试设置偏移。 -->
                                    <ports>
                                        <port>127.0.0.1:it.nacos.port:8848</port>
                                        <port>127.0.0.1:it.nacos.grpc.port:9848</port>
                                    </ports>
                                    <wait>
                                        <log>Nacos Server API started successfully</log>
                                        <time>120000</time>
                                    </wait>
                                </run>
                            </image>
                            <image>
                                <alias>rocketmq</alias>
                                <name>${it.rocketmq.image}</name>
                                <run>
                                    <containerNamePattern>domain-forge-it-${project.artifactId}-%a
                                    </containerNamePattern>
                                    <env>
                                        <JAVA_OPT_EXT>-Xms512m -Xmx512m -Xmn256m</JAVA_OPT_EXT>
                                    </env>
                                    <cmd>
                                        <exec>
                                            <arg>sh</arg>
                                            <arg>-c</arg>
                                            <arg>printf 'brokerClusterName=DefaultCluster\nbrokerName=broker-a\nbrokerId=0\nbrokerIP1=127.0.0.1\nautoCreateTopicEnable=false\nautoCreateSubscriptionGroup=false\n' &gt; /tmp/broker.conf &amp;&amp; printf '{"rocketMQClusterName":"DefaultCluster","grpcServerPort":${it.rocketmq.port}}' &gt; /tmp/proxy.json &amp;&amp; (./mqnamesrv &amp;) &amp;&amp; exec ./mqbroker -n 127.0.0.1:9876 --enable-proxy -pc /tmp/proxy.json -c /tmp/broker.conf</arg>
                                        </exec>
                                    </cmd>
                                    <ports>
                                        <port>127.0.0.1:${it.rocketmq.port}:${it.rocketmq.port}</port>
                                    </ports>
                                    <wait>
                                        <log>rocketmq-proxy startup successfully</log>
                                        <time>120000</time>
                                    </wait>
                                </run>
                            </image>
                            <image>
                                <alias>powerjob</alias>
                                <name>${it.powerjob.image}</name>
                                <run>
                                    <containerNamePattern>domain-forge-it-${project.artifactId}-%a
                                    </containerNamePattern>
                                    <network>
                                        <mode>custom</mode>
                                        <name>${it.network}</name>
                                        <alias>powerjob</alias>
                                    </network>
                                    <extraHosts>
                                        <host>host.docker.internal:host-gateway</host>
                                    </extraHosts>
                                    <env>
                                        <JVMOPTIONS>-Xmx512m -Dpowerjob.network.external.address=127.0.0.1</JVMOPTIONS>
                                        <PARAMS>--spring.profiles.active=product --spring.datasource.core.driver-class-name=org.postgresql.Driver --spring.datasource.core.jdbc-url=jdbc:postgresql://postgres:5432/domainforge --spring.datasource.core.username=domainforge --spring.datasource.core.password=${it.password} --spring.datasource.remote.hibernate.properties.hibernate.dialect=tech.powerjob.server.persistence.config.dialect.AdpPostgreSQLDialect --oms.auth.initiliaze.admin.password=${it.password} --oms.auth.openapi.enable=true --oms.transporter.active.protocols=HTTP --oms.transporter.main.protocol=HTTP --oms.http.port=${it.powerjob.transport.port}</PARAMS>
                                    </env>
                                    <ports>
                                        <port>127.0.0.1:it.powerjob.port:7700</port>
                                        <port>127.0.0.1:${it.powerjob.transport.port}:${it.powerjob.transport.port}</port>
                                    </ports>
                                    <dependsOn>
                                        <container>postgres</container>
                                    </dependsOn>
                                    <wait>
                                        <log>Started PowerJobServerApplication</log>
                                        <time>180000</time>
                                    </wait>
                                </run>
                            </image>
                        </images>
                    </configuration>
                    <executions>
                        <execution>
                            <id>start-it-dependencies</id>
                            <phase>pre-integration-test</phase>
                            <goals>
                                <goal>start</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>stop-it-dependencies</id>
                            <phase>post-integration-test</phase>
                            <goals>
                                <goal>stop</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <!--
              近似 IntelliJ 风格的自动格式化，只在需要时手动执行 spotless:apply，不绑定到构建；
              格式以 .editorconfig（IntelliJ）为准，由下方 checkstyle-format 检查。
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <eclipse>
                            <file>${rules.dir}/format/eclipse-formatter.xml</file>
                        </eclipse>
                        <importOrder>
                            <order>,javax|java,\#</order>
                        </importOrder>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
            </plugin>
            <!-- 说明位置、复杂度上限与 SQL 文本：生产与测试分别使用各自配置。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <inputEncoding>UTF-8</inputEncoding>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-main</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <configLocation>${rules.dir}/checkstyle/main.xml</configLocation>
                            <includeTestSourceDirectory>false</includeTestSourceDirectory>
                            <outputFile>${project.build.directory}/checkstyle-main.xml</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>checkstyle-format</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <configLocation>${rules.dir}/checkstyle/format.xml</configLocation>
                            <sourceDirectories>
                                <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
                                <sourceDirectory>${project.build.testSourceDirectory}</sourceDirectory>
                            </sourceDirectories>
                            <includeTestSourceDirectory>false</includeTestSourceDirectory>
                            <outputFile>${project.build.directory}/checkstyle-format.xml</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>checkstyle-test</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <configLocation>${rules.dir}/checkstyle/test.xml</configLocation>
                            <sourceDirectories>
                                <sourceDirectory>${project.build.testSourceDirectory}</sourceDirectory>
                            </sourceDirectories>
                            <includeTestSourceDirectory>false</includeTestSourceDirectory>
                            <outputFile>${project.build.directory}/checkstyle-test.xml</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 直接使用的依赖必须显式声明；未使用的声明不阻断（Starter、运行时依赖）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>declared-dependencies</id>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                        <configuration>
                            <failOnWarning>true</failOnWarning>
                            <ignoreNonCompile>false</ignoreNonCompile>
                            <ignoreAllNonTestScoped>true</ignoreAllNonTestScoped>
                            <ignoredUnusedDeclaredDependencies>
                                <ignoredUnusedDeclaredDependency>*:*</ignoredUnusedDeclaredDependency>
                            </ignoredUnusedDeclaredDependencies>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- 有 Java 生产源码的模块自动执行平台架构规则（domain-forge-build-rules 中的 ModuleArchitectureTest）。 -->
        <profile>
            <id>architecture-rules</id>
            <activation>
                <file>
                    <exists>${basedir}/src/main/java</exists>
                </file>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.domainforge</groupId>
                    <artifactId>domain-forge-build-rules</artifactId>
                    <version>${domain-forge-build-rules.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <dependenciesToScan>
                                <dependency>org.domainforge:domain-forge-build-rules</dependency>
                            </dependenciesToScan>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
