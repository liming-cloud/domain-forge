<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.domainforge</groupId>
        <artifactId>platform</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>framework</artifactId>
    <packaging>pom</packaging>
    <modules>
        <module>domain-forge-defaults</module>
        <module>domain-forge-cache</module>
        <module>domain-forge-web-support</module>
        <module>domain-forge-persistence</module>
        <module>domain-forge-access-control</module>
        <module>domain-forge-config</module>
        <module>domain-forge-service-call</module>
        <module>domain-forge-messaging</module>
        <module>domain-forge-scheduling</module>
        <module>domain-forge-tracing</module>
        <module>domain-forge-file-storage</module>
        <module>domain-forge-notification</module>
        <module>domain-forge-idempotency</module>
    </modules>
    <build>
        <plugins>
            <!-- 配置属性类生成 spring-configuration-metadata.json，供 IDE 补全与配置文档使用。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
