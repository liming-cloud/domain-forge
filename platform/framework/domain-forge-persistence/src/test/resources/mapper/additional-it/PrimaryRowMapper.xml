<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.domainforge.persistence.additional.PrimaryRowMapper">
    <insert id="insert">INSERT INTO primary_row (value) VALUES (#{value})</insert>
    <select id="count" resultType="int">SELECT count(*) FROM primary_row WHERE value = #{value}</select>
</mapper>
