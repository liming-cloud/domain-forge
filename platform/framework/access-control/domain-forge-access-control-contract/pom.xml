<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion>
<parent><groupId>org.domainforge</groupId><artifactId>access-control</artifactId><version>0.1.0</version><relativePath>../pom.xml</relativePath></parent>
<artifactId>domain-forge-access-control-contract</artifactId><version>0.3.0-iam.1</version>
<dependencies><dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-api</artifactId><scope>test</scope></dependency>
<dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-engine</artifactId><scope>test</scope></dependency></dependencies>
<build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <flattenMode>clean</flattenMode>
          <outputDirectory>${project.build.directory}</outputDirectory>
          <updatePomFile>true</updatePomFile>
        </configuration>
        <executions>
          <execution>
            <id>consumer-pom</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
